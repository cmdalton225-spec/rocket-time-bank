<?xml version="1.0" encoding="utf-8"?>
<!-- Tap anywhere to open Asher's cockpit; the round button pauses / plays the flight right here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_description"
        android:scaleType="fitCenter"
        android:src="@drawable/rocket" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_clock"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_clock_placeholder"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_label_placeholder"
        android:textColor="#FFFCBF09"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/widget_action"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/pause"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_pause"
        android:visibility="gone" />
</LinearLayout>
